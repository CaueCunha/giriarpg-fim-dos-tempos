    },
    {
      "type": "text",
      "range": [
        2,
        2
      ],
      "weight": 1,
      "name": "\"Atrás de uma porta fechada há um buraco gritante. Se seguirem a trilha escavada, acharão tesouro abundante!\"",
      "description": "A Sala 7 (passagem-truque): o túnel não tem armadilha e leva ao tesouro da Sala 16.",
      "_id": "X28HkSegchND75us",
      "img": null,
      "documentUuid": null,
      "drawn": false,
      "flags": {},
      "_stats": {

    {
      "type": "text",
      "range": [
        6,
        6
      ],
      "weight": 1,
      "name": "\"Três masmorras têm riquezas. Para alguns, já é o fim. Mas a última proeza é vencer o carmesim.\"",
      "description": "As três masmorras guardam riquezas, mas o objetivo final é o dragão vermelho.",
      "_id": "Keje6ys7UnnQumoM",
      "img": null,
      "documentUuid": null,
      "drawn": false,
      "flags": {},

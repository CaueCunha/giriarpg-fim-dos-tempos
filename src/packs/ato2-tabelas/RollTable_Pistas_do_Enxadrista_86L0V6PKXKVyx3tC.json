    },
    {
      "type": "text",
      "range": [
        3,
        3
      ],
      "weight": 1,
      "name": "\"Não importa a lombada, nem toda história é lida. Às vezes, com uma dentada, dos livros viramos comida!\"",
      "description": "O mímico da estante (Sala 3).",
      "_id": "e5sHB74YFQWkQXvC",
      "img": null,
      "documentUuid": null,
      "drawn": false,
      "flags": {},
      "_stats": {
        "coreVersion": "14.366",

    {
      "type": "text",
      "range": [
        8,
        8
      ],
      "weight": 1,
      "name": "\"Não tenho mais a contar, isso é tudo que posso dizer! Se quiserem ainda jogar, será por puro prazer!\"",
      "description": "Acabaram as pistas.",
      "_id": "RPeZmuZiZeAYphgY",

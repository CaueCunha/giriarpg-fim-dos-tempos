    },
    {
      "type": "text",
      "range": [
        4,
        4
      ],
      "weight": 1,
      "name": "\"Invisíveis na masmorra andam caça e caçador. Não enfrente, apenas corra! Um é medo e outro é horror.\"",
      "description": "O rarvnaak (caçador invisível) e o metaliano.",
      "_id": "hcRTsJ4cErTqUYwQ",
      "img": null,
      "documentUuid": null,
      "drawn": false,
      "flags": {},
      "_stats": {
        "coreVersion": "14.366",
        "systemId": "tormenta20",

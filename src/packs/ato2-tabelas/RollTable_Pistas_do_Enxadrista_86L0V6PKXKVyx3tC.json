    },
    {
      "type": "text",
      "range": [
        7,
        7
      ],
      "weight": 1,
      "name": "\"Na masmorra estão amigos, um falso e um de verdade. Esqueçam os seus umbigos e não façam caridade!\"",
      "description": "O duplo (o amigo falso) e quem o grupo veio resgatar (o de verdade).",
      "_id": "FR7yRFWRxUBmeYzU",
      "img": null,
      "documentUuid": null,

      "_key": "!tables.results!86L0V6PKXKVyx3tC.hcRTsJ4cErTqUYwQ"
    },
    {
      "type": "text",
      "range": [
        5,
        5
      ],
      "weight": 1,
      "name": "\"Amarelo leva ao sol e o roxo, à sabedoria. De um, precisam de um bicho e da outra, uma dinastia.\"",
      "description": "Os círculos: amarelo leva a Azgher, roxo a Tanna-Toh. Azgher precisa de um bicho (o aurumvorax para o Tesouro Infinito); Tanna-Toh, de uma dinastia (o livro da genealogia para as múmias).",
      "_id": "xrbBal7k9kLd3Z1f",
      "img": null,
      "documentUuid": null,
      "drawn": false,
      "flags": {},
      "_stats": {
        "coreVersion": "14.366",
